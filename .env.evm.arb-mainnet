CHAIN_ID="42161"
STARTING_CURSOR_BLOCK_NUMBER="416469410"
EVM_RPC_URL="https://arb1.arbitrum.io/rpc"

# Above a 5,000 block range Alchemy caps a response at 10K logs; below it there
# is no cap, so a range refusal is not reachable at all. Measured density says
# the cap would not be hit at 10,000 either -- this chain averages 0.0002 matched
# events per block, about 2 per 10,000 blocks -- but the stream fails fast on a
# refusal rather than splitting out of one, and a 2x wider backfill is not worth
# an occasional stall. Staying under the boundary. Supersedes #172.
GET_LOGS_RANGE_SIZE="5000"
