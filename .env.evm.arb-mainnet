CHAIN_ID="42161"
STARTING_CURSOR_BLOCK_NUMBER="416469410"
EVM_RPC_URL="https://arb1.arbitrum.io/rpc"

# Above a 5,000 block range Alchemy caps a response at 10K logs, and the stream
# fails fast on a refusal rather than splitting its way out. Measured density
# says that cap is not reachable here: this chain averages 0.0002 matched events
# per block, so a 10,000 block span carries roughly 2 -- several thousand times of headroom. #172
# raised this deliberately; keeping it.
GET_LOGS_RANGE_SIZE="10000"
