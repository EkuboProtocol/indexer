  "unknown": "any first word >= 2**160 that is not a tag, or fewer than 32 bytes, reverts UnknownForwardAction(); a first word < 2**160 is decoded as a swap"
 },
 "identity": {
  "controller": "Locker.addr() of the locker that forwarded the creation (Core-authenticated). Only controller claims; part of the CREATE2 salt.",
  "owner": "ZeroSeedLaunchPeriphery.launchOwner[poolId], set to msg.sender of create, transferable with transferLaunch; gates claimFees. Attribute creators from LaunchOwnerChanged(poolId, 0x0, owner).",
  "address_prediction": "token address = CREATE2(extension, keccak256(abi.encode(controller, salt)), MintableERC20 init code with name/symbol/decimals). The controller is the locker that forwards the creation; the periphery passes salt = keccak256(abi.encode(owner, userSalt)). Refused when the address already has code. Same salt with other metadata, another salt, another owner or another controller is independent.",
  "calldata_targets": {
   "create": "periphery.create(LaunchParameters) 0x662af306",
   "preview": "periphery.previewInstallation(address owner, LaunchParameters) 0x917c1163 (or extension.previewInstallation(address controller, LaunchParameters) with the namespaced salt)",
   "claim": "periphery.claimFees(PoolKey, address recipient) 0x6906b4c0",
   "transfer": "periphery.transferLaunch(bytes32 poolId, address newOwner) 0x8b1cb36f",
   "swap": "any locker: Core.forward(extension, abi.encode(PoolKey, SwapParameters)); native ETH as address(0) with value. Payload unchanged."
  },
  "recipient_refusals": {
   "error": "InvalidRecipient() (periphery)",
   "refused": [
    "address(0)",
    "Core",
    "extension",
    "periphery",
    "poolKey.token0",
    "poolKey.token1"
   ],
   "accepted_examples": [
    "owner",
    "EOA",
    "other contract (ETH-receiving for a native quote)"
   ],
   "atomicity": "both assets or neither; a reverting native recipient or a refused ERC-20 transfer rolls the ledger, principal and Core balances back; retry to another recipient pays both in full",
   "reentrancy": "the ledger is moved onto the lock before Core pays; an owner contract re-entering claimFees during the payment claims zero"
  }
 },
