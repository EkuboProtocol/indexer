# Alchemy applies no result cap below a 5,000 block range, and a 10K log cap
# above it. Staying under that boundary means an oversized-range refusal is not
# reachable, which matters because the stream fails fast on one rather than
# splitting its way out -- see the eth_getLogs error path in src/evm/logStream.ts.
GET_LOGS_RANGE_SIZE="5000"
